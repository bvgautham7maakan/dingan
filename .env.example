# Copy to .env and adjust. Never commit .env.
DATABASE_URL="file:../data/kem.db"
# Temporary password given to every seeded user (forced change at first login)
SEED_TEMP_PASSWORD="Kem@Temp2026"
# Set to "true" when served over HTTPS (Tailscale Funnel) so cookies are Secure
COOKIE_SECURE="false"
# Copy uploads (photos, voice notes) into each project's OneDrive job folder, sub-folder
# "KEM App uploads". Off unless "true"; only used for projects with a OneDrive path set by an admin.
ONEDRIVE_MIRROR="false"
UPLOAD_DIR="data/uploads"
NEXT_TELEMETRY_DISABLED=1
# Nightly backup target (OneDrive folder). Example:
# BACKUP_DIR="C:\Users\gautham\OneDrive - SABR HOLDINGS LTD\KEM App Backup"
BACKUP_DIR=""
# "false" = seed master data only (users, sites, projects, workers, materials, holidays) – use when going live
SEED_DEMO="true"
